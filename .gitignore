__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# --- Pacotes / build ---
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- Testes / qualidade ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/

